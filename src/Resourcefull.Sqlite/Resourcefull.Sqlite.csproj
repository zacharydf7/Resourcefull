<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>SQLite storage for Resourcefull: a single database file, with no server to run, that streams content in chunks with bounded memory, keeps versions and content hashes, and provisions its own tables.</Description>
    <Title>Resourcefull.Sqlite</Title>
    <PackageTags>$(PackageTags);sqlite</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Resourcefull\Resourcefull.csproj" />
  </ItemGroup>

  <!-- The repository logic shared with Resourcefull.SqlServer and Resourcefull.PostgreSql, compiled from source. Its
       code names the context and models unqualified, so these usings bind it to this provider's own. -->
  <ItemGroup>
    <Compile Include="..\Shared\EntityFramework\*.cs" Link="EntityFramework\%(Filename)%(Extension)" />
    <Using Include="Resourcefull.EntityFramework" />
    <Using Include="Resourcefull.Sqlite" />
    <Using Include="Resourcefull.Sqlite.Models" />
  </ItemGroup>

</Project>
