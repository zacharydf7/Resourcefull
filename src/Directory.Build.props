<Project>

  <!-- The repository-wide settings still apply. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Package metadata shared by every Resourcefull package; each project adds its own Title and Description. -->
  <PropertyGroup>
    <!-- The next release's version. Only a release's own build, from its tag, is exactly this: other CI builds are
         -ci.<run> and local ones -dev, so a test package can't pass for the release. A release candidate's tag, such as
         v4.0.0-rc.1, gives its build the suffix after the dash. -->
    <VersionPrefix>4.0.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == '' and '$(GITHUB_REF_TYPE)' == 'tag' and $(GITHUB_REF_NAME.Contains('-'))">$(GITHUB_REF_NAME.Substring($([MSBuild]::Add($(GITHUB_REF_NAME.IndexOf('-')), 1))))</VersionSuffix>
    <VersionSuffix Condition="'$(VersionSuffix)' == '' and '$(GITHUB_ACTIONS)' == 'true' and '$(GITHUB_REF_TYPE)' != 'tag'">ci.$(GITHUB_RUN_NUMBER)</VersionSuffix>
    <VersionSuffix Condition="'$(VersionSuffix)' == '' and '$(GITHUB_ACTIONS)' != 'true'">dev</VersionSuffix>
    <Authors>Zachary Fry</Authors>
    <Copyright>Copyright (c) 2024-2026 Zachary Fry</Copyright>
    <PackageTags>file-storage;file-upload;blob;blob-storage;object-storage;uploads;downloads;versioning;sqlserver;streaming;opentelemetry</PackageTags>
    <PackageProjectUrl>https://resourcefull.dev/</PackageProjectUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- Packing fails on any change that would break code compiled against the last release; bump it at each release.
         There's no baseline until 4.0.0 is released: then set it to 4.0.0. -->

    <!-- XML docs ship in the packages for IntelliSense and the API reference, so every public member needs one. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <!-- Every await uses ConfigureAwait(false); .editorconfig says why. -->
    <WarningsAsErrors>$(WarningsAsErrors);CA2007</WarningsAsErrors>

    <!-- A symbol package, so a debugger can show line numbers. The repository is private, so nothing links to its source. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>

  <!-- Deterministic paths in what CI builds and publishes. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)../assets/icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
