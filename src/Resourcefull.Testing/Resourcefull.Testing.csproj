<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <Description>The contract every Resourcefull provider must keep, as xUnit v3 tests: derive a class that registers your provider, and the suite runs against it.</Description>
    <Title>Resourcefull.Testing</Title>
    <PackageTags>$(PackageTags);testing;xunit;contract-tests</PackageTags>
    <!-- A library of tests, not a test project of its own: the tests run in the project that derives from them. -->
    <IsTestProject>false</IsTestProject>
    <!-- The test methods are public for xUnit and named for what they check, so they carry no XML docs. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="xunit.analyzers" Version="2.2.0" PrivateAssets="all" />
    <PackageReference Include="xunit.v3.assert" Version="4.0.2" />
    <PackageReference Include="xunit.v3.extensibility.core" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Resourcefull\Resourcefull.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
