<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>SQL Server storage for Resourcefull: streams content in chunks with bounded memory, keeps versions and content hashes, and ships idempotent provisioning and upgrade scripts.</Description>
    <Title>Resourcefull.SqlServer</Title>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
		<!-- Lifts the version Microsoft.Data.SqlClient brings in transitively, which has known vulnerabilities. -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Resourcefull\Resourcefull.csproj" />
	</ItemGroup>

  <ItemGroup>
    <Content Include="Scripts\Resourcefull.sql">
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\Scripts</PackagePath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Scripts\Migrations\migrate_20250513172319_AddVersioning.sql">
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\Scripts\Migrations</PackagePath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="Scripts\Migrations\migrate_20260624193539_RedesignKeysAndVersioning.sql">
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\Scripts\Migrations</PackagePath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="Scripts\Migrations\migrate_20261028213132_NameLimitsAndCaseSensitiveNames.sql">
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\Scripts\Migrations</PackagePath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="Scripts\Migrations\migrate_20261028220856_UniqueLatestVersion.sql">
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\Scripts\Migrations</PackagePath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="Scripts\Migrations\migrate_20261029003116_EnableReadCommittedSnapshot.sql">
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\Scripts\Migrations</PackagePath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="Scripts\Migrations\migrate_20261029021712_AddContentHash.sql">
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\Scripts\Migrations</PackagePath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
