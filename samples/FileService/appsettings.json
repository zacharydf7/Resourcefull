{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Files": {
    "DefaultPolicy": {
      "MaxResourceSize": "100 MB",
      "MaxContainerSize": "1 GB",
      "AllowedContentTypes": [ "image/*", "application/pdf", "text/plain" ]
    }
  }
}
