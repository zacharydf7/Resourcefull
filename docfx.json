{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "src",
          "files": [
            "Resourcefull/Resourcefull.csproj",
            "Resourcefull.InMemory/Resourcefull.InMemory.csproj",
            "Resourcefull.AspNetCore/Resourcefull.AspNetCore.csproj",
            "Resourcefull.SqlServer/Resourcefull.SqlServer.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      { "files": [ "index.md", "toc.yml", "CONTRIBUTING.md", "CHANGELOG.md" ] },
      { "files": [ "docs/**.md", "docs/toc.yml", "samples/README.md" ] },
      { "files": [ "api/**.yml", "api/index.md" ] }
    ],
    "resource": [
      { "files": [ "assets/icon.png", "assets/icon.svg", "assets/logo.svg", "assets/logo-dark.svg" ] },
      { "files": [ "**.html" ], "src": "redirects" }
    ],
    "output": "_site",
    "template": [ "default", "modern", "template" ],
    "globalMetadata": {
      "_appName": "Resourcefull",
      "_appTitle": "Resourcefull",
      "_appLogoPath": "assets/logo.svg",
      "_appFaviconPath": "assets/icon.svg",
      "_appFooter": "<span>Resourcefull is open source under the MIT license. <a href=\"https://github.com/zacharydf7/Resourcefull\">GitHub</a> · <a href=\"https://www.nuget.org/packages/Resourcefull\">NuGet</a></span>",
      "_enableSearch": true
    }
  }
}
