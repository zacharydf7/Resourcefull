{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "src",
          "files": [
            "Resourcefull/Resourcefull.csproj",
            "Resourcefull.InMemory/Resourcefull.InMemory.csproj",
            "Resourcefull.SqlServer/Resourcefull.SqlServer.csproj"
          ]
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml"
    }
  ],
  "build": {
    "content": [
      { "files": [ "index.md", "toc.yml", "CONTRIBUTING.md" ] },
      { "files": [ "docs/**.md", "docs/toc.yml", "samples/README.md" ] },
      { "files": [ "api/**.yml", "api/index.md" ] }
    ],
    "resource": [
      { "files": [ "assets/icon.png" ] }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "Resourcefull",
      "_appTitle": "Resourcefull",
      "_appLogoPath": "assets/icon.png",
      "_appFaviconPath": "assets/icon.png",
      "_enableSearch": true
    }
  }
}
